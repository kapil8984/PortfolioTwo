# ==============================================================================
# Server-side Environment Variables Template
# (Do NOT add real secrets here. Configure these in your Vercel Project Settings)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq AI Inference Configuration
# ------------------------------------------------------------------------------
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=

# Model identifier (defaults to llama-3.3-70b-versatile; candidate fallbacks are automated)
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Transactional Email Provider (Contact Form)
# ------------------------------------------------------------------------------
# Recommended Provider: Resend (https://resend.com/api-keys)
# If using Resend, paste your 're_...' API key here.
# (SendGrid 'SG....' keys are also supported automatically)
EMAIL_PROVIDER_API_KEY=

# Email address where recruiter messages will be delivered
CONTACT_RECIPIENT_EMAIL=swatibaretha6@gmail.com

# Verified sender address:
# - Leave empty OR use 'onboarding@resend.dev' for testing with Resend.
# - If you have verified a custom domain in Resend (e.g. contact@swatibaretha.dev), specify it here.
# NOTE: Do NOT use a public @gmail.com address here as Resend rejects unverified public webmail domains.
CONTACT_SENDER_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 3. Live Web Search Provider (Optional for real-time news questions in AI Chat)
# ------------------------------------------------------------------------------
# Get key from https://tavily.com (optional)
SEARCH_PROVIDER_API_KEY=

# ------------------------------------------------------------------------------
# 4. Production Domain
# ------------------------------------------------------------------------------
APP_BASE_URL=https://swati-baretha.vercel.app
