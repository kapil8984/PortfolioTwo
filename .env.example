# Server-side Environment Variables (Never expose in client-side code)
# Groq AI Inference Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Transactional Email Provider (e.g., Resend, SendGrid, Postmark)
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
CONTACT_RECIPIENT_EMAIL=swatibaretha6@gmail.com
CONTACT_SENDER_EMAIL=onboarding@resend.dev

# Live Search Provider for Current Events/News (e.g., Tavily, Serper, Brave Search)
# Optional: If not provided, the AI Assistant will transparently explain that live search is unavailable.
SEARCH_PROVIDER=tavily
SEARCH_PROVIDER_API_KEY=

# Application URL for canonical links and metadata
APP_BASE_URL=https://swati-baretha.vercel.app
